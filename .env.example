# All optional
PORT=8000
# Text put in front of the base64 session. Leave empty for plain base64.
SESSION_PREFIX=
# Link shown in the "setup guide" message
GUIDE_VIDEO_URL=https://youtube.com/@gamerpraise-mods
# Force a WhatsApp web version if you ever get 405 errors, e.g. 2.3000.1044015310
WA_VERSION=
MAX_ACTIVE_SESSIONS=40
# Optional real image (jpg/png) sent with the guide, e.g. https://img.youtube.com/vi/<VIDEO_ID>/hqdefault.jpg
GUIDE_IMAGE_URL=
# Where the "sessions generated" number is saved (use a persistent disk on your host)
COUNTER_FILE=./counter.json
