# Copy to ".env" or set these in your host's environment variables. ALL optional.

PORT=8000

# --- Branding / links shown on the website ---------------------------------
SITE_NAME=Gamerpraise Session
YOUTUBE_URL=https://youtube.com/@gamerpraise-mods
GITHUB_URL=https://github.com/Gamerpraise/
CHANNEL_URL=https://whatsapp.com/channel/0029VbBRPc3CMY0IePiiU808

# --- Session format --------------------------------------------------------
# Choices shown in the "Session format" dropdown (comma separated).
# The first option is always "Plain (no prefix)".
PREFIX_OPTIONS=Gideon~,Praise~
# Optional: link sent in the WhatsApp message (setup guide video)
GUIDE_VIDEO_URL=https://youtube.com/@gamerpraise-mods

# --- Limits / tuning -------------------------------------------------------
MAX_ACTIVE_SESSIONS=40
# Where the "sessions generated" number is saved (use a persistent disk if your host has one)
COUNTER_FILE=./counter.json
# Force a WhatsApp web version if you ever get 405 errors, e.g. 2.3000.1044015310
WA_VERSION=
